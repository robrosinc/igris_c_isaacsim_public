#usda 1.0
(
    defaultPrim = "IGRIS_C_WRIST_HAND"
    subLayers = [
        @igris_c_face_outer.usdc@,
        @igris_c_torso_outer.usdc@,
        @igris_c.usd@
    ]
)

over "IGRIS_C_WRIST_HAND"
{
    def Scope "Looks_Painted"
    {
        def Material "mat_0"
        {
            token outputs:surface.connect = </IGRIS_C_WRIST_HAND/Looks_Painted/mat_0/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (1, 1, 1)
                float inputs:metallic = 0.8
                float inputs:opacity = 1
                float inputs:roughness = 0.4
                token outputs:surface
            }
        }

        def Material "mat_1"
        {
            token outputs:surface.connect = </IGRIS_C_WRIST_HAND/Looks_Painted/mat_1/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.5647118, 0.5647118, 0.5647118)
                float inputs:metallic = 0.8
                float inputs:opacity = 1
                float inputs:roughness = 0.4
                token outputs:surface
            }
        }

        def Material "mat_3"
        {
            token outputs:surface.connect = </IGRIS_C_WRIST_HAND/Looks_Painted/mat_3/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.8, 0.8, 0.8)
                float inputs:metallic = 1
                float inputs:opacity = 1
                float inputs:roughness = 0.1
                token outputs:surface
            }
        }
    }

    over "Looks_TorsoOuter"
    {
        over "mat_25"
        {
            over "PreviewSurface"
            {
                color3f inputs:diffuseColor = (1, 1, 1)
                float inputs:metallic = 0.8
                float inputs:opacity = 1
                float inputs:roughness = 0.4
            }
        }
    }

    over "base_link"
    {
        over "visuals" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding = </IGRIS_C_WRIST_HAND/Looks_Painted/mat_0> (
                bindMaterialAs = "strongerThanDescendants"
            )
        }
    }

